// Zugriffsregeln für die Vereins-Version des KSV 08/15 Spielbuchs.
// In der Firebase-Konsole unter Firestore Database → Regeln einfügen und „Veröffentlichen“.
// VERWALTER_EMAIL durch die E-Mail-Adresse des Verwalters (kleingeschrieben) ersetzen.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() { return request.auth != null && request.auth.token.email_verified == true; }
    function verwalterMail() { return angemeldet() && request.auth.token.email.lower() == 'VERWALTER_EMAIL'; }
    function hatProfil() { return angemeldet() && exists(/databases/$(database)/documents/nutzer/$(request.auth.uid)); }
    function rolle() { return hatProfil() ? get(/databases/$(database)/documents/nutzer/$(request.auth.uid)).data.rolle : ''; }
    function darfLesen() { return verwalterMail() || rolle() in ['lesen', 'schreiben', 'admin']; }
    function darfSchreiben() { return verwalterMail() || rolle() in ['schreiben', 'admin']; }
    function istVerwalter() { return verwalterMail() || rolle() == 'admin'; }
    function profil() { return get(/databases/$(database)/documents/nutzer/$(request.auth.uid)).data; }
    function istKassierer() { return hatProfil() && profil().get('kassierer', false) == true; }
    function nurZahlstatus() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pay']); }
    function eigeneZahlungGemeldet() {
      let s = hatProfil() ? profil().get('spielerId', null) : null;
      return s is string
        && request.resource.data.pay.diff(resource.data.get('pay', {})).affectedKeys().hasOnly([s])
        && request.resource.data.pay[s] == 'check';
    }

    match /config/{id}    { allow read: if darfLesen(); allow write: if darfSchreiben(); }
    // Spieltage: Eintragende schreiben alles; Kassierer ändern den Zahlstatus;
    // jedes Mitglied darf für den eigenen Spieler „wird geprüft“ melden (nach Zahlung über PayPal)
    match /spieltage/{id} {
      allow read: if darfLesen();
      allow write: if darfSchreiben();
      allow update: if darfLesen() && nurZahlstatus() && (istKassierer() || eigeneZahlungGemeldet());
    }
    match /regelwerk/{id} { allow read: if darfLesen(); allow write: if darfSchreiben(); }

    match /planung/{id} {
      allow read: if darfLesen();
      allow create: if darfLesen() && request.resource.data.von == request.auth.uid;
      allow update: if darfLesen() && (resource.data.von == request.auth.uid || istVerwalter())
        && request.resource.data.von == resource.data.von;
      allow delete: if darfLesen() && (resource.data.von == request.auth.uid || istVerwalter());
      // Kommentare: alle Mitglieder schreiben; löschen dürfen Verfasser, Ersteller des Eintrags und Verwalter
      match /kommentare/{kid} {
        allow read: if darfLesen();
        allow create: if darfLesen() && request.resource.data.von == request.auth.uid;
        allow delete: if darfLesen() && (resource.data.von == request.auth.uid || istVerwalter()
          || get(/databases/$(database)/documents/planung/$(id)).data.von == request.auth.uid);
      }
      match /stimmen/{uid} {
        allow read: if darfLesen();
        allow create, update: if darfLesen() && request.auth.uid == uid;
        allow delete: if darfLesen() && (request.auth.uid == uid || istVerwalter()
          || get(/databases/$(database)/documents/planung/$(id)).data.von == request.auth.uid);
      }
    }

    // Push-Nachrichten: Ereignisse melden (nur schreiben; gelesen und gelöscht werden sie vom Versand-Ablauf)
    match /ereignisse/{id} {
      allow create: if angemeldet() && request.resource.data.von == request.auth.uid
        && (darfLesen() || (request.resource.data.kat == 'verwaltung' && request.resource.data.an == 'verwalter'));
    }
    // Geräte, die Nachrichten bekommen: jedes Konto verwaltet nur seine eigenen
    match /geraete/{token} {
      allow create, update: if angemeldet() && request.resource.data.uid == request.auth.uid;
      allow delete: if angemeldet() && resource.data.uid == request.auth.uid;
    }

    match /nutzer/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || istVerwalter();
      // eigene Auswahl der Benachrichtigungs-Themen
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['push']);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'rolle', 'spielerId', 'angelegt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.spielerId == null
        && (request.resource.data.rolle == 'warten' || (verwalterMail() && request.resource.data.rolle == 'admin'));
      allow update, delete: if istVerwalter();
    }
  }
}
