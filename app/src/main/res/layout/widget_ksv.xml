<?xml version="1.0" encoding="utf-8"?>
<!-- Startbildschirm-Widget: Tabellenstand, nächster Termin, offener Betrag -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher_round" />
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_stand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFA8A296"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_zeitraum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFA8A296"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_leer"
        android:textColor="#FFD9D5CC"
        android:textSize="13sp" />
    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView
            android:id="@+id/w_r1"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:textColor="#FFE6A521"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/w_v1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD9D5CC"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView
            android:id="@+id/w_r2"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:textColor="#FFE6A521"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/w_v2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD9D5CC"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView
            android:id="@+id/w_r3"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:textColor="#FFE6A521"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/w_v3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD9D5CC"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView
            android:id="@+id/w_r4"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:textColor="#FFE6A521"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/w_v4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD9D5CC"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <TextView
            android:id="@+id/w_r5"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:textColor="#FFE6A521"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_n5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/w_v5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD9D5CC"
            android:textSize="13sp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#33FFFFFF" />
    <TextView
        android:id="@+id/w_termin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/w_offen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#FFE6A521"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
